{
  "manifest_version": 3,
  "name": "keyNav",
  "version": "0.1.0",
  "description": "Keyboard-first browsing: Vimium-style link hints, scrolling, and tab control.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hints.js", "content/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "keyNav — press f for link hints",
    "default_popup": "popup/popup.html"
  }
}
